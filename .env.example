# Site domain WITHOUT protocol (https:// is prepended). Used for canonical URLs, OG, sitemap and RSS.
# In production it is set in Vercel -> Project -> Settings -> Environment Variables.
NEXT_PUBLIC_BASE_URL=www.salvacastro.com.ar

# Google Search Console verification code (HTML tag method).
# Get it from https://search.google.com/search-console -> Add property -> HTML tag
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code_here

# Google Analytics 4 Measurement ID.
# Get it from https://analytics.google.com -> Admin -> Data Streams -> Web stream
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
